{
  "name": "dsh-plugin-git-graph",
  "version": "1.0.0",
  "description": "DeepSeek Harness 可视化 Git 分支图谱与版本控制插件 (Visual Git Graph & Repository Operations for DeepSeek Harness)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "git",
    "git-graph",
    "version-control",
    "sidebar"
  ],
  "author": "yaan",
  "license": "MIT"
}
